bin/
obj/
.vs/
*.user
*.suo
.DS_Store
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
*.pdb
TestResults/

# Local harness runtime state (reconnect logs etc.)
server/

# SUT comparison runs: keep the small reports (REPORT.md / diff.json /
# surface.json / telnet.txt), ignore the bulky server state + logs (*.log is
# already ignored globally, which covers loadgen.log). Run dirs are
# comparison/<scenario>/<stock|zdtd>/...
workspace/comparison/*/*/userdata/
workspace/comparison/*/*/world/
workspace/comparison/*/*/boot.log
workspace/comparison/*/*/server.log
workspace/comparison/*/*/serverconfig.xml
# Raw 7dtd-apm sessions are ~10MB/30s of regenerable flame/perf artifacts; the
# compact cost snapshot travels in surface.json (apmStock) + REPORT.md.
workspace/comparison/*/*/apm/
workspace/comparison/run.log

# bench-stock lane: keep the small reports (run-meta.json / stats.json /
# bench-stock.md|json), ignore the server runtime. Runs are laid out as
# workspace/bench/<lap>/{userdata,boot.log} plus
# workspace/bench/<lap>/<scenario>/apm/, so the APM pattern needs the scenario
# level: a one-level-short pattern silently let ~150MB of regenerable
# perf.script / *.bt.out into the history once already.
workspace/bench/*/userdata/
workspace/bench/*/boot.log
workspace/bench/*/apm/
workspace/bench/*/*/apm/**
# ...except the per-session summary.json, the only APM file bench_report.py
# reads (ipc + layer scores). ~9KB each against multi-MB perf/bt captures, so
# `make bench-report` still reproduces the committed report from a clean
# checkout. Re-including under an ignored dir needs the dir itself unignored.
!workspace/bench/*/*/apm/
!workspace/bench/*/*/apm/session_*/
!workspace/bench/*/*/apm/session_*/summary.json
*.lock

# Local scratch and one-off repro artifacts.
.scratch/

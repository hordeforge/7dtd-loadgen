<Project>
  <!-- Central build flags: single source of truth for every project in src/. -->
  <PropertyGroup>
    <!-- Pin the language level instead of 'latest', which floats with whichever
         SDK compiles the tree (SDK 8 -> C# 12, SDK 9 -> C# 13, ...). -->
    <LangVersion>12</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Map the checkout directory out of emitted bits so two checkouts at
         different paths produce identical DLL/PDB bytes. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <!-- Do not query git while compiling: implicit SourceLink embeds the
         absolute checkout path plus a HEAD-commit URL into PDBs, which makes
         artifacts depend on git metadata and checkout location. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- Normalize source paths extra on CI (GitHub Actions sets CI). -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Analyzer posture: SDK analyzers on, code style checked at build time,
         and every warning fails the compile (CI runs these via make test).
         Rules the tree does not pass yet stay off: raising AnalysisLevel
         above the default is a follow-up once its findings are fixed. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Restore-time vulnerability audit. NuGet checks advisories during
         restore already, but it reports them as warnings, and TreatWarningsAsErrors
         does not cover restore diagnostics, so an advisory in the locked
         transitive test graph (or in the LiteNetLib fallback) was something a
         reader had to notice in the log. AuditMode=all widens the SDK default
         ('direct') to the whole resolved graph, and the NU1901-NU1904 codes
         below are the four severity buckets, so an advisory fails the lane the
         dependency-contract gate runs in. NU1905 (a source that serves no
         advisory data) stays a warning: an offline mirror is not a finding. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
